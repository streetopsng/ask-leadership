rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Sessions collection
    match /sessions/{sessionId} {
      // The voter's marker id for the session's current round, as voteRef() in sessionService builds it.
      function voteMarkerPath(session) {
        let base = string(session.round) + '_' + request.auth.uid;
        let id = session.get('hostedSessionId', null) is string ? base + '_' + session.hostedSessionId : base;
        return /databases/$(database)/documents/sessions/$(sessionId)/votes/$(id);
      }

      // A participant's vote adds exactly one to the count, in the same write that creates their marker.
      function isOwnVoteCount() {
        let marker = voteMarkerPath(get(/databases/$(database)/documents/sessions/$(sessionId)).data);
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['votes', 'expireAt'])
          && request.resource.data.votes == resource.data.votes + 1
          && !exists(marker)
          && existsAfter(marker);
      }

      // Anyone authenticated can create a session
      allow create: if request.auth != null;

      // Only the host can update session fields (phase, round, etc.)
      // A GummyGum re-run reuses the PIN, so a new hosted session's host may claim the doc.
      allow update: if request.auth != null
        && (request.auth.uid == resource.data.hostUid
          || (request.resource.data.hostUid == request.auth.uid
            && request.resource.data.get('hostedSessionId', null) is string
            && request.resource.data.hostedSessionId != resource.data.get('hostedSessionId', null)));

      // Anyone authenticated can read (for join-by-code)
      allow read: if request.auth != null;

      match /rate_limits/{uid} {
        allow create, update: if request.auth != null
          && request.auth.uid == uid;
        allow read: if request.auth != null;
        allow delete: if false;
      }

      // Questions subcollection
      match /questions/{questionId} {
        // Participants can create questions (with their own uid)
        allow create: if request.auth != null
          && request.resource.data.participantUid == request.auth.uid
          && (!exists(/databases/$(database)/documents/sessions/$(sessionId)/rate_limits/$(request.auth.uid))
            || request.time.toMillis() - get(/databases/$(database)/documents/sessions/$(sessionId)/rate_limits/$(request.auth.uid)).data.lastSubmissionAt.toMillis() >= 10000);

        // Only the host can update (mark answered) or delete questions; participants can only count their own vote
        allow update: if request.auth != null
          && (request.auth.uid == get(/databases/$(database)/documents/sessions/$(sessionId)).data.hostUid
            || isOwnVoteCount());
        allow delete: if request.auth != null
          && request.auth.uid == get(/databases/$(database)/documents/sessions/$(sessionId)).data.hostUid;

        // Anyone authenticated can read questions
        allow read: if request.auth != null;
      }

      // Votes subcollection
      match /votes/{voteId} {
        // Participants can create one vote per round (enforced by doc ID: round_uid)
        allow create: if request.auth != null
          && voteId.split('_')[1] == request.auth.uid;

        // No updates or deletes allowed
        allow update, delete: if false;

        // Anyone authenticated can read votes
        allow read: if request.auth != null;
      }
    }
  }
}
